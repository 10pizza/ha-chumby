#!/bin/sh
# HA-Chumby USB startup entrypoint.
# start.sh is finite: it shows the splash, restores Zurk startup, then exits
# so the original Chumby boot sequence can continue.

LOG="/tmp/ha-chumby.log"
USB_ROOT="/mnt/usb"
APP=""

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') debugchumby: $*" >> "$LOG"
}

log "starting HA-Chumby USB entrypoint"
log "PATH=$PATH"

if [ -r "$USB_ROOT/ha-chumby/start.sh" ]; then
    APP="$USB_ROOT/ha-chumby/start.sh"
    log "found app at $APP"
elif [ -r "/mnt/storage/ha-chumby/start.sh" ]; then
    APP="/mnt/storage/ha-chumby/start.sh"
    log "found app at $APP"
else
    log "ERROR: HA-Chumby startup script not found"
    exit 1
fi

log "execing finite HA-Chumby startup overlay"
exec sh "$APP"
